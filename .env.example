# 复制本文件为 .env 并填入你自己的值。.env 已被 .gitignore 排除，绝不要提交。
# 生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 在 https://aistudio.google.com 申请
GEMINI_API_KEY=
# 可选：主模型。换模型只需改这里（改完要重启服务器）
GEMINI_MODEL=gemini-3.8-flash
# 可选：备用模型。主模型过载(503)、额度用完(429)或不存在(404)时自动改用；留空表示不使用
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 可选：单次请求最长等待秒数，超过就放弃并尝试备用模型（默认 45）
GEMINI_TIMEOUT_SECONDS=45
# 论文推荐：在 https://openalex.org/settings/api 免费申请
OPENALEX_API_KEY=
# 可选：论文检索的超时秒数（默认 20）
OPENALEX_TIMEOUT_SECONDS=20
# 用 Google 账号登录（可选）：在 https://console.cloud.google.com/apis/credentials 创建“OAuth 客户端 ID”（Web 应用），
# 并把 http://127.0.0.1:5000/auth/google/callback 加进“已获授权的重定向 URI”（部署后再加上线上地址）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 可选：部署在代理后面、自动生成的回调地址不对时，在这里写死完整的回调地址
GOOGLE_REDIRECT_URI=
# 可选：本机开发时设为 1 开启调试模式（自动重载 + 错误页）。部署到网上时绝对不要打开
FLASK_DEBUG=
