# 复制本文件为 .env 并填入你自己的值。.env 已被 .gitignore 排除，绝不要提交。
# 生成密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 在 https://aistudio.google.com 申请
GEMINI_API_KEY=
# 可选：主模型。换模型只需改这里（改完要重启服务器）
GEMINI_MODEL=gemini-3.8-flash
# 可选：备用模型。主模型过载(503)、额度用完(429)或不存在(404)时自动改用；留空表示不使用
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# 可选：单次请求最长等待秒数，超过就放弃并尝试备用模型（默认 45）
GEMINI_TIMEOUT_SECONDS=45
# 论文推荐：在 https://openalex.org/settings/api 免费申请
OPENALEX_API_KEY=
# 可选：论文检索的超时秒数（默认 20）
OPENALEX_TIMEOUT_SECONDS=20
# 用 Google 账号登录（可选）：在 https://console.cloud.google.com/apis/credentials 创建“OAuth 客户端 ID”（Web 应用），
# 并把 http://127.0.0.1:5000/auth/google/callback 加进“已获授权的重定向 URI”（部署后再加上线上地址）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 可选：部署在代理后面、自动生成的回调地址不对时，在这里写死完整的回调地址
GOOGLE_REDIRECT_URI=
# ---------- 邮件（验证邮箱、忘记密码、提醒邮件） ----------
# 不设置 SMTP_HOST 时是“开发模式”：邮件不会真的发出，而是打印在服务器日志里（链接也在里面）。
# 任何支持 SMTP 的服务都行。例如 Gmail：SMTP_HOST=smtp.gmail.com，SMTP_PORT=587，SMTP_USERNAME=你的邮箱，
# SMTP_PASSWORD=Google 账号里生成的“应用专用密码”（不是登录密码；需要先开启两步验证）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 端口用 starttls（默认）；465 端口把它改成 ssl
SMTP_SECURITY=starttls
# 发件人，例如 Assignment Helper <noreply@你的域名>。用 Gmail 时必须是你自己的 Gmail 地址
MAIL_FROM=
# 可选：强制指定 smtp / console / off（off 完全关闭发信）
MAIL_BACKEND=
# 邮件里的链接用的网站地址。部署后必须设置，例如 https://app.example.com；本机开发留空即可
APP_BASE_URL=

# ---------- 推送通知 ----------
# 不设置时，第一次使用会自动生成密钥并保存在 instance/vapid.json（本机开发够用）。
# 部署时必须固定下来，否则服务器重建后所有设备都要重新开启推送。生成方法：python generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# 可选：推送服务出问题时联系你的地址，例如 mailto:你的邮箱（默认取自 MAIL_FROM）
VAPID_SUBJECT=

# ---------- 定时发送提醒 ----------
# 只有“没有 cron 的托管平台”才需要：设置一串足够长的随机字符，然后定时用
# POST /cron/reminders 加请求头 Authorization: Bearer <这串字符> 来触发。留空表示关闭这个入口
REMINDER_TOKEN=
# 可选：本机开发时设为 1 开启调试模式（自动重载 + 错误页）。部署到网上时绝对不要打开
FLASK_DEBUG=
